{
  "manifest_version": 3,
  "name": "Resume Tailor",
  "version": "1.0",
  "description": "Tailor resume directly from the active job posting tab.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
